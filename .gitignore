# Tauri build artifacts
src-tauri/target/

# CFA - Context First Architecture
# Keep: cfa.yaml, map.md, decisions/*.md (valuable for devs)
# Ignore: session-specific and generated files
.claude/settings.local.json
.claude/.onboarding_status
.claude/memory.db
.claude/knowledge_graph.db
.claude/tasks/
# agentful runtime state
.agentful/

# Private project states and snapshots
.agentcockpit/states/
.agentcockpit/snapshots.json

# Databases (knowledge graph, orchestration, MCP)
.claude/*.db
.claude/*.db-shm
.claude/*.db-wal

# Active workflow state (private)
.claude/workflow/

# Workflow manager runtime data (sessions, screenshots, DBs)
.workflow-manager/data/
.workflow-manager/.venv/

# Obsolete agents directory
.agents/

# Private/custom workflows (only debug-graph.yaml is public)
